{
  "name": "news-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.mjs && node scripts/build-client-scripts.mjs && astro dev",
    "build": "node scripts/generate-pwa-icons.mjs && node scripts/build-client-scripts.mjs && astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/generate-pwa-icons.mjs && node scripts/build-client-scripts.mjs && astro build && wrangler deploy",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "fixtures": "node scripts/generate-test-fixtures.mjs",
    "typecheck": "npm run fixtures && astro check && tsc --noEmit",
    "test": "npm run fixtures && vitest run",
    "test:watch": "npm run fixtures && vitest",
    "lint": "oxlint src/ tests/ --deny-warnings --ignore-pattern '**/*.astro'",
    "lint:fix": "oxlint src/ tests/ --fix --ignore-pattern '**/*.astro'",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.3.8",
    "fast-xml-parser": "^5.0.9",
    "tailwindcss": "^4.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "vite-plugin-pwa": "^2.0.0",
    "esbuild": "^0.28.0",
    "knip": "^6.6.1",
    "oxlint": "^1.61.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.150.0"
  }
}
